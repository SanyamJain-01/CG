# Copy to .env.properties (git-ignored) for local runs. In production, set the same values as environment variables.

# Required. At least 32 bytes. Generate one with: openssl rand -base64 48      (env: JWT_SECRET)
cg.jwt.secret=

# Optional. Without a key, scans still run and findings have no AI explanation.   (env: LLM_API_KEY)
cg.llm.api-key=
# Any OpenAI-compatible API; these are the defaults.                       (env: LLM_BASE_URL, LLM_MODEL)
#cg.llm.base-url=https://api.groq.com/openai/v1
#cg.llm.model=openai/gpt-oss-120b

# Semgrep rule pack (needs network) or a local rules file.                  (env: SEMGREP_CONFIG)
#cg.scanners.semgrep-config=p/default

# The database defaults match docker-compose.yml.          (env: DATABASE_URL, DATABASE_USER, DATABASE_PASSWORD)
#spring.datasource.url=jdbc:postgresql://localhost:5433/cg
